<UserControl x:Class="HardwarePOS.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HardwarePOS.Helpers"
             xmlns:views="clr-namespace:HardwarePOS.Views">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border Style="{StaticResource CardBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="0,0,6,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:TextBoxHelper.Placeholder="Search suppliers by name or contact…"/>
                    <Button Grid.Column="1" Content="+ Add Supplier" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewCommand}"/>
                </Grid>
                <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.4*" MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridEllipsisCell}">
                                    <Setter Property="ToolTip" Value="{Binding CompanyName}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="140" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridEllipsisCell}">
                                    <Setter Property="ToolTip" Value="{Binding ContactPerson}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridEllipsisCell}">
                                    <Setter Property="ToolTip" Value="{Binding Phone}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" MinWidth="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridEllipsisCell}">
                                    <Setter Property="ToolTip" Value="{Binding Email}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" MinWidth="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridEllipsisCell}">
                                    <Setter Property="ToolTip" Value="{Binding Address}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Status" Width="90" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GridIconButton}" ToolTip="Edit"
                                                ContentTemplate="{StaticResource EditIconContent}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource GridIconButton}" ToolTip="Archive"
                                                ContentTemplate="{StaticResource ArchiveIconContent}"
                                                Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource GridIconButtonDanger}" ToolTip="Delete"
                                                ContentTemplate="{StaticResource DeleteIconContent}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <views:FormOverlay Title="{Binding FormTitle}"
                           Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}"
                           CancelCommand="{Binding CloseFormCommand}"
                           SaveCommand="{Binding SaveCommand}">
            <StackPanel>
                <TextBlock Text="Company Name" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Contact Person" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Phone" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Email" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Address" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
                <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,8,0,0"/>
            </StackPanel>
        </views:FormOverlay>
    </Grid>
</UserControl>
