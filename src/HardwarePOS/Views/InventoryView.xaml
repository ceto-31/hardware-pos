<UserControl x:Class="HardwarePOS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HardwarePOS.Views" xmlns:helpers="clr-namespace:HardwarePOS.Helpers"
             TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
    <UserControl.Resources>
        <Style x:Key="DropdownPlaceholder" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,32,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><Trigger Property="Tag" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="StockFilterToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LowStockFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource StockFilterToggle}">
            <Setter Property="Background" Value="#FEF9C3"/>
            <Setter Property="Foreground" Value="#CA8A04"/>
            <Setter Property="BorderBrush" Value="#FDE047"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FEF08A"/>
                    <Setter Property="BorderBrush" Value="#CA8A04"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OutOfStockFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource StockFilterToggle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FECACA"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpiringSoonFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource StockFilterToggle}">
            <Setter Property="Background" Value="#FFEDD5"/>
            <Setter Property="Foreground" Value="#EA580C"/>
            <Setter Property="BorderBrush" Value="#FDBA74"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FED7AA"/>
                    <Setter Property="BorderBrush" Value="#EA580C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <TabControl Style="{StaticResource ModernTabControl}"
                ItemContainerStyle="{StaticResource ModernTabItem}"
                UseLayoutRounding="True" SnapsToDevicePixels="True"
                SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Stock Monitoring">
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshMonitoringCommand}"/>
                        <ToggleButton Content="Low Stock" Style="{StaticResource LowStockFilterToggle}"
                                      IsChecked="{Binding FilterLowStock}"/>
                        <ToggleButton Content="Out of Stock" Style="{StaticResource OutOfStockFilterToggle}"
                                      IsChecked="{Binding FilterOutOfStock}"/>
                        <ToggleButton Content="Expiring Soon" Style="{StaticResource ExpiringSoonFilterToggle}"
                                      IsChecked="{Binding FilterExpiringSoon}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding InventoryItems}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding StockStatus, Converter={StaticResource StockStatusBrush}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExpirationAlertStatus}" Value="ExpiringSoon">
                                        <Setter Property="Background" Value="#FFEDD5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExpirationAlertStatus}" Value="Expired">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="80"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQty, StringFormat=0.###}" Width="90">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridNumericHeader}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reorder At" Binding="{Binding ReorderLevel, StringFormat=0.###}" Width="120" MinWidth="120">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridNumericHeader}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="110" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Expires" Binding="{Binding ExpirationDisplay, Mode=OneWay}" Width="110" MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="Stock In">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="960" HorizontalAlignment="Left" Margin="12" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
                    <TextBlock Text="Receive stock from supplier" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid Width="680" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Supplier for this delivery" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding SupplierOptions}" DisplayMemberPath="CompanyName" SelectedValuePath="SupplierId" SelectedValue="{Binding InSupplierId}"/>
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" SelectedValue="{Binding InCategoryId}"/>
                            <TextBlock Text="Product" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding InProductOptions}" DisplayMemberPath="ProductName" SelectedValuePath="ProductId" SelectedValue="{Binding InProductId}"/>
                            <TextBlock Text="Incoming quantity" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding InQuantityText,UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Date received" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding InDate}"/>
                            <TextBlock Text="Delivery expiry (optional)" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding InExpirationDate}"/>
                            <Button Content="Clear expiry" Command="{Binding ClearInExpirationDateCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"/>
                            <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding InRemarks,UpdateSourceTrigger=PropertyChanged}" Height="72" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="14" Margin="0,14,0,10">
                        <WrapPanel>
                            <TextBlock Text="Current stock: " FontWeight="SemiBold"/><TextBlock Text="{Binding CurrentInStock,StringFormat={}{0:0.###}}"/>
                            <TextBlock Text="  + Incoming: " FontWeight="SemiBold"/><TextBlock Text="{Binding InQuantity,StringFormat={}{0:0.###}}"/>
                            <TextBlock Text="  = After receiving: " FontWeight="SemiBold"/><TextBlock Text="{Binding AfterReceiving,StringFormat={}{0:0.###}}"/>
                            <TextBlock Text="{Binding InUnit}" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </Border>
                    <Button Content="Save Stock In" Command="{Binding SaveStockInCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                    <TextBlock Text="Existing deliveries — oldest first" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <TextBlock Text="Each new delivery is saved separately. Current stock includes all suppliers." Foreground="#64748B" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding InBatches}" MaxHeight="260" MinWidth="680" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchId}" Width="70"/>
                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt,StringFormat=MMM d yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Received" Binding="{Binding OriginalQuantity,StringFormat=0.###}" Width="100"/>
                            <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingQuantity,StringFormat=0.###}" Width="100"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Stock Out">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="680" HorizontalAlignment="Left" Margin="12" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
                    <TextBlock Text="Issue stock or record damaged products" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <ComboBox x:Name="OutCategoryBox" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" SelectedValue="{Binding OutCategoryId}"/>
                        <TextBlock Text="Select a category…" Tag="{Binding SelectedItem,ElementName=OutCategoryBox}" Style="{StaticResource DropdownPlaceholder}"/>
                    </Grid>
                    <TextBlock Text="Product" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <ComboBox x:Name="OutProductBox" ItemsSource="{Binding OutProductOptions}" DisplayMemberPath="ProductName" SelectedValuePath="ProductId" SelectedValue="{Binding OutProductId}"/>
                        <TextBlock Text="Select a product…" Tag="{Binding SelectedItem,ElementName=OutProductBox}" Style="{StaticResource DropdownPlaceholder}"/>
                    </Grid>
                    <TextBlock Text="Affected delivery / supplier" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <ComboBox x:Name="OutDeliveryBox" ItemsSource="{Binding OutBatches}" DisplayMemberPath="Display" SelectedValuePath="BatchId" SelectedValue="{Binding OutBatchId}"/>
                        <TextBlock Text="Select a delivery… (optional, oldest stock first)" Tag="{Binding SelectedItem,ElementName=OutDeliveryBox}" Style="{StaticResource DropdownPlaceholder}"/>
                    </Grid>
                    <Button Content="Use oldest stock first" Command="{Binding ClearOutBatchCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"/>
                    <TextBlock Text="Select a delivery for supplier tracing. With none selected, stock is taken oldest first." Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding OutQuantityText,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Date" Style="{StaticResource FieldLabel}"/><DatePicker SelectedDate="{Binding OutDate}"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Reason" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <ComboBox x:Name="OutReasonBox" ItemsSource="{Binding StockOutReasons}" SelectedItem="{Binding OutReason}"/>
                        <TextBlock Text="Select a reason…" Tag="{Binding SelectedItem,ElementName=OutReasonBox}" Style="{StaticResource DropdownPlaceholder}"/>
                    </Grid>
                    <TextBlock Text="Damaged items move from saleable stock to BO. Dispose or return them from the BO tab." TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,4"/>
                    <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding OutRemarks,UpdateSourceTrigger=PropertyChanged}" Height="72" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <Button Content="Save Stock Out" Command="{Binding SaveStockOutCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="History">
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Refresh History" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshHistoryCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <views:PaginationBar DockPanel.Dock="Bottom" DataContext="{Binding HistoryPage}"/>
                    <DataGrid ItemsSource="{Binding HistoryPage.Items}" helpers:Paging.GridSource="{Binding HistoryPage}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="70"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding QtyChange, StringFormat=N3}" Width="80"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter, StringFormat=N3}" Width="90"/>
                            <DataGridTextColumn Header="By" Binding="{Binding CreatedByName}" Width="120"/>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>
        <TabItem Header="Supplier Deliveries">
            <DockPanel Margin="12" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Supplier" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="260" ItemsSource="{Binding HistorySuppliers}" DisplayMemberPath="CompanyName" SelectedValuePath="SupplierId" SelectedValue="{Binding DeliverySupplierFilter}"/>
                    <Button Content="Refresh" Command="{Binding RefreshDeliveriesCommand}" Style="{StaticResource SecondaryButton}"/>
                </WrapPanel>
                <views:PaginationBar DockPanel.Dock="Bottom" DataContext="{Binding DeliveriesPage}"/>
                <DataGrid ItemsSource="{Binding DeliveriesPage.Items}" helpers:Paging.GridSource="{Binding DeliveriesPage}" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchId}" Width="70"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt,StringFormat=MMM d yyyy}" Width="115"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="Received" Binding="{Binding OriginalQuantity,StringFormat=0.###}" Width="100"/>
                        <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingQuantity,StringFormat=0.###}" Width="100"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                        <DataGridTextColumn Header="Expiry" Binding="{Binding ExpirationDate,StringFormat=MMM d yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="BO / Defective Stock">
            <DockPanel Margin="12" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Defective stock — excluded from saleable inventory" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <ComboBox Width="260" ItemsSource="{Binding HistorySuppliers}" DisplayMemberPath="CompanyName" SelectedValuePath="SupplierId" SelectedValue="{Binding DeliverySupplierFilter}"/>
                        <Button Content="Refresh" Command="{Binding RefreshDeliveriesCommand}" Style="{StaticResource SecondaryButton}"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="For the selected BO entry" FontWeight="SemiBold"/>
                    <WrapPanel>
                        <TextBlock Text="Quantity" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Width="100" Text="{Binding BoQuantityText,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Reason" VerticalAlignment="Center" Margin="12,0,8,0"/><TextBox Width="280" MaxLength="300" Text="{Binding BoReason,UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Dispose" Command="{Binding DisposeBoCommand}" CommandParameter="Disposed" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Return to supplier" Command="{Binding DisposeBoCommand}" CommandParameter="ReturnedToSupplier" Style="{StaticResource SecondaryButton}"/>
                    </WrapPanel>
                    <TextBlock Text="These actions reduce BO only; they do not deduct saleable stock again." Foreground="#64748B"/>
                </StackPanel>
                <views:PaginationBar DockPanel.Dock="Bottom" DataContext="{Binding BadStockPage}"/>
                <DataGrid ItemsSource="{Binding BadStockPage.Items}" helpers:Paging.GridSource="{Binding BadStockPage}" SelectedItem="{Binding SelectedBadStock}" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BO #" Binding="{Binding BadStockId}" Width="60"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt,StringFormat=MMM d yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchId}" Width="70"/>
                        <DataGridTextColumn Header="Original" Binding="{Binding Quantity,StringFormat=0.###}" Width="75"/>
                        <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingQuantity,StringFormat=0.###}" Width="90"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="85"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
