<Window x:Class="HardwarePOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HardwarePOS.ViewModels"
        Title="4KV Hardware"
        Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,16">
                    <TextBlock Text="4KV Hardware" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Point of Sale &amp; Inventory" Foreground="#9FB3C8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,16">
                    <TextBlock Text="{Binding UserLabel}" Foreground="#9FB3C8" Margin="12,0,12,8" TextWrapping="Wrap"/>
                    <Button Content="Logout" Style="{StaticResource NavButton}" Command="{Binding LogoutCommand}"/>
                </StackPanel>

                <StackPanel>
                    <Button Content="Dashboard" Style="{StaticResource NavButton}" Command="{Binding NavigateDashboardCommand}"/>
                    <Button Content="Point of Sale" Style="{StaticResource NavButton}" Command="{Binding NavigatePosCommand}"/>
                    <Button Content="Products" Style="{StaticResource NavButton}" Command="{Binding NavigateProductsCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Suppliers" Style="{StaticResource NavButton}" Command="{Binding NavigateSuppliersCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Inventory" Style="{StaticResource NavButton}" Command="{Binding NavigateInventoryCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" Padding="20,14" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding HeaderTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Margin="8"/>
        </DockPanel>
    </Grid>
</Window>
