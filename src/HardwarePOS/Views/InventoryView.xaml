<UserControl x:Class="HardwarePOS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StockFilterToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LowStockFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource StockFilterToggle}">
            <Setter Property="Background" Value="#FEF9C3"/>
            <Setter Property="Foreground" Value="#CA8A04"/>
            <Setter Property="BorderBrush" Value="#FDE047"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FEF08A"/>
                    <Setter Property="BorderBrush" Value="#CA8A04"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OutOfStockFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource StockFilterToggle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FECACA"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpiringSoonFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource StockFilterToggle}">
            <Setter Property="Background" Value="#FFEDD5"/>
            <Setter Property="Foreground" Value="#EA580C"/>
            <Setter Property="BorderBrush" Value="#FDBA74"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FED7AA"/>
                    <Setter Property="BorderBrush" Value="#EA580C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <TabControl Style="{StaticResource ModernTabControl}"
                ItemContainerStyle="{StaticResource ModernTabItem}"
                UseLayoutRounding="True" SnapsToDevicePixels="True"
                SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Stock Monitoring">
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshMonitoringCommand}"/>
                        <ToggleButton Content="Low Stock" Style="{StaticResource LowStockFilterToggle}"
                                      IsChecked="{Binding FilterLowStock}"/>
                        <ToggleButton Content="Out of Stock" Style="{StaticResource OutOfStockFilterToggle}"
                                      IsChecked="{Binding FilterOutOfStock}"/>
                        <ToggleButton Content="Expiring Soon" Style="{StaticResource ExpiringSoonFilterToggle}"
                                      IsChecked="{Binding FilterExpiringSoon}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding InventoryItems}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding StockStatus, Converter={StaticResource StockStatusBrush}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExpirationAlertStatus}" Value="ExpiringSoon">
                                        <Setter Property="Background" Value="#FFEDD5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExpirationAlertStatus}" Value="Expired">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                            <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="80"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQty, StringFormat=N0}" Width="90">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridNumericHeader}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reorder At" Binding="{Binding ReorderLevel, StringFormat=N0}" Width="120" MinWidth="120">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridNumericHeader}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="110" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Expires" Binding="{Binding ExpirationDisplay}" Width="110" MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="Stock In">
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Receive stock from supplier" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Select a category to filter products." Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Padding="0,16,0,0" Margin="0,12,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Button Content="Save Stock In" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveStockInCommand}" HorizontalAlignment="Right"
                                MinWidth="140" Padding="18,8"/>
                    </Border>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Category" Style="{StaticResource DialogFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="CategoryName"
                                      SelectedValuePath="CategoryId" SelectedValue="{Binding InCategoryId}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Supplier" Style="{StaticResource DialogFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding SupplierOptions}" DisplayMemberPath="CompanyName"
                                      SelectedValuePath="SupplierId" SelectedValue="{Binding InSupplierId}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <TextBlock Text="Product" Style="{StaticResource DialogFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding InProductOptions}" DisplayMemberPath="ProductName"
                                      SelectedValuePath="ProductId" SelectedValue="{Binding InProductId}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4,0,0">
                            <TextBlock Text="Quantity" Style="{StaticResource DialogFieldLabel}"/>
                            <TextBox Text="{Binding InQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,4,0,0">
                            <TextBlock Text="Date Received" Style="{StaticResource DialogFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding InDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <TextBlock Text="Remarks" Style="{StaticResource DialogFieldLabel}"/>
                            <TextBox Text="{Binding InRemarks, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="120" VerticalAlignment="Stretch"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="Stock Out">
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Issue / adjust stock out" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Select a category to filter products." Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Padding="0,16,0,0" Margin="0,12,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Button Content="Save Stock Out" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveStockOutCommand}" HorizontalAlignment="Right"
                                MinWidth="140" Padding="18,8"/>
                    </Border>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Category" Style="{StaticResource DialogFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="CategoryName"
                                      SelectedValuePath="CategoryId" SelectedValue="{Binding OutCategoryId}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Reason" Style="{StaticResource DialogFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding StockOutReasons}" SelectedItem="{Binding OutReason}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <TextBlock Text="Product" Style="{StaticResource DialogFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding OutProductOptions}" DisplayMemberPath="ProductName"
                                      SelectedValuePath="ProductId" SelectedValue="{Binding OutProductId}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4,0,0">
                            <TextBlock Text="Quantity" Style="{StaticResource DialogFieldLabel}"/>
                            <TextBox Text="{Binding OutQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,4,0,0">
                            <TextBlock Text="Date" Style="{StaticResource DialogFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding OutDate}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <TextBlock Text="Remarks" Style="{StaticResource DialogFieldLabel}"/>
                            <TextBox Text="{Binding OutRemarks, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="120" VerticalAlignment="Stretch"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="History">
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Refresh History" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshHistoryCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding History}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="70"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding QtyChange, StringFormat=N3}" Width="80"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter, StringFormat=N3}" Width="90"/>
                            <DataGridTextColumn Header="By" Binding="{Binding CreatedByName}" Width="120"/>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
