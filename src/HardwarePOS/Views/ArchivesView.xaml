<UserControl x:Class="HardwarePOS.Views.ArchivesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:helpers="clr-namespace:HardwarePOS.Helpers" xmlns:views="clr-namespace:HardwarePOS.Views"
 Background="{StaticResource BgBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid Margin="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource ReportCard}">
   <StackPanel>
    <TextBlock Text="Manage archived records" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
    <TextBlock Text="Find inactive products and suppliers, then restore them when needed." Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="1" Style="{StaticResource ModernTabControl}" ItemContainerStyle="{StaticResource ModernTabItem}">
   <TabItem Header="Archived products">
    <Border Style="{StaticResource ManagementCard}" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
       <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock Text="Products" FontSize="18" FontWeight="SemiBold"/>
         <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
          <TextBlock Text="{Binding ProductsPage.TotalCount}" Foreground="{StaticResource MutedBrush}"/>
         </Border>
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshProductsCommand}" Style="{StaticResource SecondaryButton}"/>
       </Grid>
       <TextBox Text="{Binding ProductSearch,UpdateSourceTrigger=PropertyChanged}" helpers:TextBoxHelper.Placeholder="Search archived products…"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom">
       <views:PaginationBar DataContext="{Binding ProductsPage}"/>
       <TextBlock Text="Restore makes a record available again. Only unused records can be permanently deleted." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <Grid MinHeight="220">
       <DataGrid ItemsSource="{Binding ProductsPage.Items}" helpers:Paging.GridSource="{Binding ProductsPage}" SelectedItem="{Binding SelectedProduct}" Style="{StaticResource ManagementDataGrid}" RowHeight="64" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="120"/>
<DataGridTemplateColumn Header="Product" Width="*" MinWidth="180" SortMemberPath="ProductName"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center">
<TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
<TextBlock Text="{Binding VariantDetails}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
</StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="Stock" Binding="{Binding StockQty,StringFormat=0.###}" Width="90" ElementStyle="{StaticResource GridNumericCell}" HeaderStyle="{StaticResource GridNumericHeader}"/>
<DataGridTextColumn Header="Unit" Binding="{Binding UnitOfMeasure}" Width="100"/>
         <DataGridTemplateColumn Header="Actions" Width="180">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Restore" Style="{StaticResource SecondaryButton}" Padding="12,6" Command="{Binding DataContext.RestoreProductCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
            <Button Content="Delete" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" ToolTip="Permanently delete this unused record" Command="{Binding DataContext.PermanentDeleteProductCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
           </StackPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <Border Background="White" Margin="0,48,0,0" Visibility="{Binding ProductsPage.IsEmpty,Converter={StaticResource BoolToVis}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
         <Border Background="#EFF6FF" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
          <TextBlock Text="↶" FontSize="30" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Border>
         <TextBlock Text="No archived products found" FontWeight="SemiBold" FontSize="18" TextAlignment="Center" Margin="0,14,0,6"/>
         <TextBlock Text="Archived products will appear here. If you searched, try another name." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>
        </StackPanel>
       </Border>
      </Grid>
     </DockPanel>
    </Border>
   </TabItem>
   <TabItem Header="Archived suppliers">
    <Border Style="{StaticResource ManagementCard}" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
       <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock Text="Suppliers" FontSize="18" FontWeight="SemiBold"/>
         <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
          <TextBlock Text="{Binding SuppliersPage.TotalCount}" Foreground="{StaticResource MutedBrush}"/>
         </Border>
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshSuppliersCommand}" Style="{StaticResource SecondaryButton}"/>
       </Grid>
       <TextBox Text="{Binding SupplierSearch,UpdateSourceTrigger=PropertyChanged}" helpers:TextBoxHelper.Placeholder="Search archived suppliers…"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom">
       <views:PaginationBar DataContext="{Binding SuppliersPage}"/>
       <TextBlock Text="Restore makes a record available again. Only unused records can be permanently deleted." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <Grid MinHeight="220">
       <DataGrid ItemsSource="{Binding SuppliersPage.Items}" helpers:Paging.GridSource="{Binding SuppliersPage}" SelectedItem="{Binding SelectedSupplier}" Style="{StaticResource ManagementDataGrid}" RowHeight="64" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="*" MinWidth="160"/>
<DataGridTextColumn Header="Contact person" Binding="{Binding ContactPerson}" Width="180"/>
<DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="145"/>
         <DataGridTemplateColumn Header="Actions" Width="180">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
           <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Restore" Style="{StaticResource SecondaryButton}" Padding="12,6" Command="{Binding DataContext.RestoreSupplierCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
            <Button Content="Delete" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" ToolTip="Permanently delete this unused record" Command="{Binding DataContext.PermanentDeleteSupplierCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
           </StackPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <Border Background="White" Margin="0,48,0,0" Visibility="{Binding SuppliersPage.IsEmpty,Converter={StaticResource BoolToVis}}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
         <Border Background="#EFF6FF" CornerRadius="24" Width="48" Height="48" HorizontalAlignment="Center">
          <TextBlock Text="↶" FontSize="30" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Border>
         <TextBlock Text="No archived suppliers found" FontWeight="SemiBold" FontSize="18" TextAlignment="Center" Margin="0,14,0,6"/>
         <TextBlock Text="Archived suppliers will appear here. If you searched, try another name." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>
        </StackPanel>
       </Border>
      </Grid>
     </DockPanel>
    </Border>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
