<UserControl x:Class="HardwarePOS.Views.UnitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HardwarePOS.Helpers"
             xmlns:views="clr-namespace:HardwarePOS.Views">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border Style="{StaticResource CardBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="0,0,6,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:TextBoxHelper.Placeholder="Search units…"/>
                    <Button Grid.Column="1" Content="+ Add Unit" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewCommand}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="No units found." Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,20" HorizontalAlignment="Center"/>
                <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource GridCheckBox}"/>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTemplateColumn Header="Actions" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GridIconButton}" ToolTip="Edit"
                                                ContentTemplate="{StaticResource EditIconContent}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource GridIconButtonDanger}" ToolTip="Delete"
                                                ContentTemplate="{StaticResource DeleteIconContent}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <views:FormOverlay Title="{Binding FormTitle}"
                           Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}"
                           CancelCommand="{Binding CloseFormCommand}"
                           SaveCommand="{Binding SaveCommand}">
            <StackPanel>
                <TextBlock Text="Unit Name" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,8,0,0"/>
            </StackPanel>
        </views:FormOverlay>
    </Grid>
</UserControl>
