<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:HardwarePOS.ViewModels"
                    xmlns:views="clr-namespace:HardwarePOS.Views"
                    xmlns:conv="clr-namespace:HardwarePOS.Converters"
                    xmlns:helpers="clr-namespace:HardwarePOS.Helpers">

    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    <conv:StockStatusToBrushConverter x:Key="StockStatusBrush"/>
    <conv:StatusToBadgeBrushConverter x:Key="StatusTextBrush"/>
    <conv:EqualityMultiConverter x:Key="EqualityMultiConverter"/>
    <conv:ProductImageConverter x:Key="ProductImage"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#EA580C"/>
    <SolidColorBrush x:Key="BgBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#CA8A04"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

