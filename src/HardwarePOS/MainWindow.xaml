<Window x:Class="HardwarePOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HardwarePOS.ViewModels"
        Title="4KV Hardware"
        Height="800" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="0,4,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,24,16,16">
                        <Image Source="/Assets/4kv-logo.png"
                               Width="198"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               SnapsToDevicePixels="True"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,18">
                        <TextBlock Text="{Binding UserLabel}" Foreground="#94A3B8" Margin="10,0,10,10" TextWrapping="Wrap" FontSize="14"/>
                        <Button Content="Logout" Style="{StaticResource NavButton}" Command="{Binding LogoutCommand}"/>
                    </StackPanel>

                    <StackPanel>
                        <Button Content="Dashboard" Tag="Dashboard" Style="{StaticResource NavButton}" Command="{Binding NavigateDashboardCommand}"/>
                        <Button Content="Point of Sale" Tag="Pos" Style="{StaticResource NavButton}" Command="{Binding NavigatePosCommand}"/>

                        <TextBlock Text="MASTER FILES" Foreground="#64748B" FontSize="12" Margin="16,14,8,4"
                                   Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Categories" Tag="Categories" Style="{StaticResource NavButton}" Command="{Binding NavigateCategoriesCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Units" Tag="Units" Style="{StaticResource NavButton}" Command="{Binding NavigateUnitsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Products" Tag="Products" Style="{StaticResource NavButton}" Command="{Binding NavigateProductsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Suppliers" Tag="Suppliers" Style="{StaticResource NavButton}" Command="{Binding NavigateSuppliersCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Discounts" Tag="Discounts" Style="{StaticResource NavButton}" Command="{Binding NavigateDiscountsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Users" Tag="Users" Style="{StaticResource NavButton}" Command="{Binding NavigateUsersCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="OPERATIONS" Foreground="#64748B" FontSize="12" Margin="16,14,8,4"
                                   Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Inventory" Tag="Inventory" Style="{StaticResource NavButton}" Command="{Binding NavigateInventoryCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Archives" Tag="Archives" Style="{StaticResource NavButton}" Command="{Binding NavigateArchivesCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Reports" Tag="Reports" Style="{StaticResource NavButton}" Command="{Binding NavigateReportsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" Padding="18,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding HeaderTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Margin="8"/>
        </DockPanel>
    </Grid>
</Window>
