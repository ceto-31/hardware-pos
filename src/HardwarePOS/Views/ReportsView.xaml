<UserControl x:Class="HardwarePOS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Style="{StaticResource CardBorder}">
        <DockPanel UseLayoutRounding="True" SnapsToDevicePixels="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox Width="200" ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding ReportType}" Margin="2"/>
                <ComboBox Width="90" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" Margin="2"/>
                <Button Content="Generate" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}"/>
                <Button Content="Export PDF" Style="{StaticResource SecondaryButton}" Command="{Binding ExportPdfCommand}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="No data for this report." HorizontalAlignment="Center" Margin="0,20"
                       Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}"/>
            <Border DockPanel.Dock="Top" Height="260" Margin="0,0,0,10"
                    Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ChartTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <lvc:CartesianChart x:Name="ReportChart"
                                        Series="{Binding ChartSeries}"
                                        XAxes="{Binding ChartXAxes}"
                                        YAxes="{Binding ChartYAxes}"
                                        TooltipPosition="Top"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True"/>
                </DockPanel>
            </Border>
            <DataGrid x:Name="ReportGrid"
                      Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Col1}" Width="*"/>
                    <DataGridTextColumn Header="Total Sales" Binding="{Binding Col2}" Width="*"/>
                    <DataGridTextColumn Header="Column 3" Binding="{Binding Col3}" Width="*"/>
                    <DataGridTextColumn Header="Column 4" Binding="{Binding Col4}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
