<ContentControl x:Class="HardwarePOS.Views.FormOverlay"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:HardwarePOS.Views"
                Focusable="True"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="20"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
    <ContentControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
    </ContentControl.Resources>
    <ContentControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand, RelativeSource={RelativeSource AncestorType=local:FormOverlay}}"/>
    </ContentControl.InputBindings>
    <ContentControl.Template>
        <ControlTemplate TargetType="local:FormOverlay">
            <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Border Background="Transparent">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{TemplateBinding CancelCommand}"/>
                    </Border.InputBindings>
                </Border>
                <Grid Width="640" MinHeight="280" MaxHeight="680"
                      Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                      UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Border Background="White" CornerRadius="10" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#0F172A"/>
                        </Border.Effect>
                    </Border>
                    <Border Background="White" CornerRadius="10"
                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Display"
                            TextOptions.TextRenderingMode="ClearType">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="6" Background="{StaticResource PrimaryBrush}" CornerRadius="10,10,0,0"/>
                            <Border DockPanel.Dock="Bottom" Padding="28,16,28,24"
                                    BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                            Command="{TemplateBinding CancelCommand}"
                                            FontSize="15" MinHeight="40" MinWidth="120" Padding="18,8"/>
                                    <Button Content="Save Changes" Style="{StaticResource PrimaryButton}"
                                            Command="{TemplateBinding SaveCommand}"
                                            FontSize="15" MinHeight="40" MinWidth="120" Padding="18,8"/>
                                </StackPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Title}"
                                       FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                                       TextWrapping="Wrap" Margin="28,24,28,0"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,18,28,10"
                                          CanContentScroll="False">
                                <ContentPresenter Content="{TemplateBinding Content}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentControl.Template>
</ContentControl>
