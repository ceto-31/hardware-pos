<UserControl x:Class="HardwarePOS.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search products" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Content="Show archived" IsChecked="{Binding ShowArchived}"
                                  VerticalAlignment="Center" Margin="4,4,12,4"/>
                        <Button Content="Edit" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}"/>
                        <Button Content="Archive" Style="{StaticResource SecondaryButton}" Command="{Binding ArchiveCommand}"/>
                        <Button Content="Restore" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}"/>
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
                    </WrapPanel>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding StockStatus, Converter={StaticResource StockStatusBrush}}"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding ProductDetails}" Width="1.2*"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="100"/>
                        <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="70"/>
                        <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="Sell" Binding="{Binding SellingPrice, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQty, StringFormat=N0}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Product Name"/>
                    <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Details"/>
                    <TextBox Text="{Binding ProductDetails, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <TextBlock Text="Barcode"/>
                    <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Unit of Measure"/>
                    <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding UnitOfMeasure}"/>
                    <TextBlock Text="Cost Price"/>
                    <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Selling Price"/>
                    <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Initial Stock (add only)"/>
                    <TextBox Text="{Binding StockQty, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewProduct}"/>
                    <TextBlock Text="Reorder Level"/>
                    <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Category"/>
                    <ComboBox ItemsSource="{Binding CategoryOptions}"
                              DisplayMemberPath="CategoryName"
                              SelectedValuePath="CategoryId"
                              SelectedValue="{Binding CategoryId}"/>
                    <TextBlock Text="Supplier"/>
                    <ComboBox ItemsSource="{Binding SupplierOptions}"
                              DisplayMemberPath="CompanyName"
                              SelectedValuePath="SupplierId"
                              SelectedValue="{Binding SupplierId}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="New" Style="{StaticResource SecondaryButton}" Command="{Binding NewCommand}"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
