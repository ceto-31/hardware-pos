<UserControl x:Class="HardwarePOS.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HardwarePOS.Helpers"
             xmlns:views="clr-namespace:HardwarePOS.Views">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Border Style="{StaticResource CardBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="0,0,6,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:TextBoxHelper.Placeholder="Search users by name or username…"/>
                    <Button Grid.Column="1" Content="+ Add User" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewCommand}"/>
                </Grid>
                <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="110"/>
                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="90"/>
                        <DataGridTemplateColumn Header="Status" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Protected" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource GridIconButton}" ToolTip="Edit"
                                                    ContentTemplate="{StaticResource EditIconContent}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource GridIconButtonDanger}" ToolTip="Deactivate"
                                                    ContentTemplate="{StaticResource DeactivateIconContent}"
                                                    Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <views:FormOverlay Title="{Binding FormTitle}"
                           Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}"
                           CancelCommand="{Binding CloseFormCommand}"
                           SaveCommand="{Binding SaveCommand}">
            <StackPanel>
                <TextBlock Text="Username" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewUser}"/>
                <TextBlock Text="Full Name" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,8,0,0"/>
                <TextBlock Text="Password" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Favorite color" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding SecurityColor, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Favorite number" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding SecurityNumber, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Hobby" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding SecurityHobby, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </views:FormOverlay>
    </Grid>
</UserControl>
