<UserControl x:Class="HardwarePOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding WelcomeMessage}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding UserDisplay}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentDateTime}" VerticalAlignment="Center"
                               FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Border>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Today's Sales" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                            <Run Text="₱"/><Run Text="{Binding TodaySales, StringFormat=N2}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Today's Transactions" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding TodayTransactions}" FontSize="28" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Total Revenue" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}">
                            <Run Text="₱"/><Run Text="{Binding TotalRevenue, StringFormat=N2}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardBorder}" Height="280">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Daily Sales" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding DailySeries}" XAxes="{Binding DailyXAxes}" YAxes="{Binding YAxes}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Height="280">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Weekly Sales" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding WeeklySeries}" XAxes="{Binding WeeklyXAxes}" YAxes="{Binding YAxes}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Height="280">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Monthly Sales" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding MonthlySeries}" XAxes="{Binding MonthlyXAxes}" YAxes="{Binding YAxes}"/>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
