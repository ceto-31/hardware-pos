<Window x:Class="HardwarePOS.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="420" Height="240"
        FontFamily="Segoe UI">
    <Grid>
        <Border Background="#990F172A" CornerRadius="0"/>
        <Border Width="360" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="8" Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#0F172A"/>
            </Border.Effect>
            <DockPanel>
                <Border x:Name="AccentBar" DockPanel.Dock="Top" Height="6" Background="#2563EB" CornerRadius="8,8,0,0"/>
                <StackPanel Margin="24,20,24,20">
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" Margin="0,12,0,0" FontSize="14" Foreground="#475569" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="NoButton" Content="No" Style="{StaticResource SecondaryButton}" Click="No_Click" MinWidth="96"/>
                        <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}" Click="Ok_Click" MinWidth="96" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
