<Window x:Class="HardwarePOS.Views.VoidSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HardwarePOS.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="420" Height="360"
        FontFamily="Segoe UI">
    <Grid>
        <Border Background="#990F172A"/>
        <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="8" Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#0F172A"/>
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="6" Background="#DC2626" CornerRadius="8,8,0,0"/>
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="Void Sale" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="MessageText" Margin="0,12,0,0" FontSize="15" Foreground="#475569" TextWrapping="Wrap"/>
                    <TextBlock Text="Reason" Margin="0,28,0,6" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <Grid>
                        <ComboBox x:Name="ReasonCombo" MinHeight="40" SelectionChanged="ReasonCombo_SelectionChanged"/>
                        <TextBlock x:Name="ReasonPlaceholder" Text="Select a reason"
                                   Margin="12,0,36,0" VerticalAlignment="Center"
                                   Foreground="#94A3B8" FontSize="15" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel x:Name="OtherPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Text="Please specify" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBox x:Name="OtherText" MinHeight="40" MaxLength="200"
                                 helpers:TextBoxHelper.Placeholder="Type the reason…"
                                 TextChanged="OtherText_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Cancel" Style="{StaticResource OutlineButton}" Click="Cancel_Click" MinWidth="96" IsCancel="True"/>
                        <Button x:Name="VoidButton" Content="Void Sale" Style="{StaticResource DangerButton}"
                                Click="Void_Click" MinWidth="96" IsEnabled="False" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
