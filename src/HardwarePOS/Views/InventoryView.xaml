<UserControl x:Class="HardwarePOS.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StockFilterToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LowStockFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource StockFilterToggle}">
            <Setter Property="Background" Value="#FEF9C3"/>
            <Setter Property="Foreground" Value="#CA8A04"/>
            <Setter Property="BorderBrush" Value="#FDE047"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FEF08A"/>
                    <Setter Property="BorderBrush" Value="#CA8A04"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OutOfStockFilterToggle" TargetType="ToggleButton" BasedOn="{StaticResource StockFilterToggle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FECACA"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <TabControl Style="{StaticResource ModernTabControl}"
                ItemContainerStyle="{StaticResource ModernTabItem}"
                UseLayoutRounding="True" SnapsToDevicePixels="True"
                SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Stock Monitoring">
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshMonitoringCommand}"/>
                        <ToggleButton Content="Low Stock" Style="{StaticResource LowStockFilterToggle}"
                                      IsChecked="{Binding FilterLowStock}"/>
                        <ToggleButton Content="Out of Stock" Style="{StaticResource OutOfStockFilterToggle}"
                                      IsChecked="{Binding FilterOutOfStock}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding InventoryItems}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding StockStatus, Converter={StaticResource StockStatusBrush}}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                            <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="80"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQty, StringFormat=N0}" Width="90">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridNumericHeader}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reorder At" Binding="{Binding ReorderLevel, StringFormat=N0}" Width="120" MinWidth="120">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridNumericHeader}"/>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="110" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>

        <TabItem Header="Stock In">
            <Border Style="{StaticResource CardBorder}" MaxWidth="520" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Receive stock from supplier" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Category"/>
                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="CategoryName"
                              SelectedValuePath="CategoryId" SelectedValue="{Binding InCategoryId}"/>
                    <TextBlock Text="Supplier"/>
                    <ComboBox ItemsSource="{Binding SupplierOptions}" DisplayMemberPath="CompanyName"
                              SelectedValuePath="SupplierId" SelectedValue="{Binding InSupplierId}"/>
                    <TextBlock Text="Product"/>
                    <ComboBox ItemsSource="{Binding InProductOptions}" DisplayMemberPath="ProductName"
                              SelectedValuePath="ProductId" SelectedValue="{Binding InProductId}"/>
                    <TextBlock Text="Quantity"/>
                    <TextBox Text="{Binding InQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Date Received"/>
                    <DatePicker SelectedDate="{Binding InDate}"/>
                    <TextBlock Text="Remarks"/>
                    <TextBox Text="{Binding InRemarks, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <Button Content="Save Stock In" Style="{StaticResource PrimaryButton}" Command="{Binding SaveStockInCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </TabItem>

        <TabItem Header="Stock Out">
            <Border Style="{StaticResource CardBorder}" MaxWidth="520" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Issue / adjust stock out" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Category"/>
                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="CategoryName"
                              SelectedValuePath="CategoryId" SelectedValue="{Binding OutCategoryId}"/>
                    <TextBlock Text="Product"/>
                    <ComboBox ItemsSource="{Binding OutProductOptions}" DisplayMemberPath="ProductName"
                              SelectedValuePath="ProductId" SelectedValue="{Binding OutProductId}"/>
                    <TextBlock Text="Quantity"/>
                    <TextBox Text="{Binding OutQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Reason"/>
                    <ComboBox ItemsSource="{Binding StockOutReasons}" SelectedItem="{Binding OutReason}"/>
                    <TextBlock Text="Date"/>
                    <DatePicker SelectedDate="{Binding OutDate}"/>
                    <TextBlock Text="Remarks"/>
                    <TextBox Text="{Binding OutRemarks, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    <Button Content="Save Stock Out" Style="{StaticResource PrimaryButton}" Command="{Binding SaveStockOutCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </TabItem>

        <TabItem Header="History">
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="Refresh History" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshHistoryCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding History}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="70"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding QtyChange, StringFormat=N3}" Width="80"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter, StringFormat=N3}" Width="90"/>
                            <DataGridTextColumn Header="By" Binding="{Binding CreatedByName}" Width="120"/>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
