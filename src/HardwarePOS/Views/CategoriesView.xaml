<UserControl x:Class="HardwarePOS.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HardwarePOS.Helpers">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         helpers:TextBoxHelper.Placeholder="Search categories…"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyMessage}" Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,20" HorizontalAlignment="Center"/>
                <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*"/>
                        <DataGridTemplateColumn Header="Actions" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GridIconButton}" ToolTip="Edit"
                                                ContentTemplate="{StaticResource EditIconContent}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource GridIconButtonDanger}" ToolTip="Delete"
                                                ContentTemplate="{StaticResource DeleteIconContent}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Category Name" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"/>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="New" Style="{StaticResource SecondaryButton}" Command="{Binding NewCommand}"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                    <Button Content="Edit" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}"/>
                    <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
