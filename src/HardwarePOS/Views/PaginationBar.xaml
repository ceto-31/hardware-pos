<UserControl x:Class="HardwarePOS.Views.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"
            TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
        <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding RangeLabel}" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="Rows" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="70" Margin="0,0,16,0" MinHeight="32"/>
            <Button Content="First" Command="{Binding FirstCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" MinHeight="32"/>
            <Button Content="Previous" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" MinHeight="32"/>
            <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="12,0"/>
            <Button Content="Next" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" MinHeight="32"/>
            <Button Content="Last" Command="{Binding LastCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" MinHeight="32"/>
        </WrapPanel>
    </Border>
</UserControl>
