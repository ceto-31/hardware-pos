<UserControl x:Class="HardwarePOS.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:helpers="clr-namespace:HardwarePOS.Helpers"
             xmlns:views="clr-namespace:HardwarePOS.Views">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource ManagementCard}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox MinHeight="40" VerticalAlignment="Center" Margin="0,0,12,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             helpers:TextBoxHelper.Placeholder="Search products by name or code…"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Style="{StaticResource InlineDropdown}"
                                  ItemsSource="{Binding FilterCategories}" DisplayMemberPath="CategoryName"
                                  SelectedValuePath="CategoryId" SelectedValue="{Binding FilterCategoryId}"
                                  Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Show archived" IsChecked="{Binding ShowArchived}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="+ Add Product" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewCommand}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="No products found." HorizontalAlignment="Center" Margin="0,8,0,12"
                           Foreground="{StaticResource MutedBrush}"
                           Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}"/>
                <DataGrid Style="{StaticResource ManagementDataGrid}"
                          RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="68"
                          RowStyle="{StaticResource ProductGridRow}"
                          ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Image" Width="80" MinWidth="80" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductThumbnail}"
                                            Clip="{StaticResource ProductThumbnailClip}">
                                        <Grid>
                                            <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <Path Data="{StaticResource IconCamera}" Fill="#94A3B8"/>
                                            </Viewbox>
                                            <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                                                   Stretch="UniformToFill" Width="42" Height="42"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="110" MinWidth="96"
                                            ElementStyle="{StaticResource ManagementGridText}"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*" MinWidth="180"
                                            ElementStyle="{StaticResource ManagementGridText}"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*" MinWidth="120"
                                            ElementStyle="{StaticResource ManagementGridText}"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitOfMeasure}" Width="90" MinWidth="72"
                                            ElementStyle="{StaticResource ManagementGridText}"/>
                        <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=N2}" Width="100" MinWidth="88">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagementNumericHeader}"/>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ManagementNumericText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Sell" Width="110" MinWidth="96">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagementNumericHeader}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SellingPrice, StringFormat=N2}"
                                                   TextDecorations="Strikethrough"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   Visibility="{Binding IsOnSale, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding EffectivePrice, StringFormat=N2}"
                                                   Style="{StaticResource ManagementNumericText}"/>
                                        <TextBlock Text="SALE" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Right"
                                                   Visibility="{Binding IsOnSale, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQty, StringFormat=N0}" Width="84" MinWidth="72">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ManagementNumericHeader}"/>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ManagementNumericText}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Status" Width="156" MinWidth="148">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusBadgeTemplate}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Expires" Binding="{Binding ExpirationDisplay}" Width="130" MinWidth="118"
                                            ElementStyle="{StaticResource ManagementGridText}"/>
                        <DataGridTemplateColumn Header="Actions" Width="168" MinWidth="156">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource ManagementActions}">
                                        <Button Style="{StaticResource ManagementActionButton}" ToolTip="Edit"
                                                ContentTemplate="{StaticResource EditIconContent}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource ManagementActionButton}" ToolTip="Archive"
                                                ContentTemplate="{StaticResource ArchiveIconContent}"
                                                Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsArchived, Converter={StaticResource InverseBoolToVis}}"/>
                                        <Button Style="{StaticResource ManagementActionButton}" ToolTip="Restore"
                                                ContentTemplate="{StaticResource RestoreIconContent}"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource ManagementActionButtonDanger}" ToolTip="Delete"
                                                ContentTemplate="{StaticResource DeleteIconContent}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
            </Border>
        </ScrollViewer>

        <views:FormOverlay Title="{Binding FormTitle}"
                           Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}"
                           CancelCommand="{Binding CloseFormCommand}"
                           SaveCommand="{Binding SaveCommand}">
            <StackPanel>
                <TextBlock Text="Photo" Style="{StaticResource DialogFieldLabel}"/>
                <Button Command="{Binding BrowsePhotoCommand}" Cursor="Hand" HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,4"
                        ToolTip="Click to add or change photo">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <Border Width="140" Height="140" Background="#F1F5F9" CornerRadius="8"
                            BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}">
                                <Viewbox Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,8">
                                    <Path Data="{StaticResource IconCamera}" Fill="#94A3B8"/>
                                </Viewbox>
                                <TextBlock Text="Click to add photo" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Width="140" Height="140"
                                   Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Button>
                <Button Content="Remove photo" Style="{StaticResource LinkButton}"
                        Command="{Binding RemovePhotoCommand}" Foreground="{StaticResource MutedBrush}"
                        Margin="0,0,0,10" HorizontalAlignment="Left"
                        Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Product Code" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Product Name" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Details" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding ProductDetails, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                <TextBlock Text="Unit" Style="{StaticResource DialogFieldLabel}"/>
                <ComboBox ItemsSource="{Binding UnitOptions}" DisplayMemberPath="UnitName" SelectedValuePath="UnitId" SelectedValue="{Binding UnitId}"/>
                <TextBlock Text="Cost Price" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Selling Price" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Sale Price (optional)" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Sale Start" Style="{StaticResource DialogFieldLabel}"/>
                <DatePicker SelectedDate="{Binding SaleStartDate}"/>
                <TextBlock Text="Sale End" Style="{StaticResource DialogFieldLabel}"/>
                <DatePicker SelectedDate="{Binding SaleEndDate}"/>
                <Button Content="Clear sale" Style="{StaticResource LinkButton}"
                        Command="{Binding ClearSaleCommand}" Foreground="{StaticResource MutedBrush}"
                        Margin="0,0,0,10" HorizontalAlignment="Left"
                        Visibility="{Binding HasSaleFields, Converter={StaticResource BoolToVis}}"/>
                <Border CornerRadius="6" Padding="8,6" Margin="0,4,0,8" HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProfitTone}" Value="Positive">
                                    <Setter Property="Background" Value="#F0FDF4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProfitTone}" Value="Negative">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ProfitSummary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProfitTone}" Value="Positive">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ProfitTone}" Value="Negative">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Text="Initial Stock" Style="{StaticResource DialogFieldLabel}"
                           Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Current Stock" Style="{StaticResource DialogFieldLabel}"
                           Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBox Text="{Binding StockQty, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewProduct}"/>
                <TextBlock Text="Adjust stock from Inventory (Stock In / Stock Out)."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8"
                           Visibility="{Binding IsNewProduct, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBlock Text="Reorder Level" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Expiration Date (optional)" Style="{StaticResource DialogFieldLabel}"/>
                <DatePicker SelectedDate="{Binding ExpirationDate}"/>
                <Button Content="Clear expiration date" Style="{StaticResource LinkButton}"
                        Command="{Binding ClearExpirationDateCommand}" Foreground="{StaticResource MutedBrush}"
                        Margin="0,0,0,10" HorizontalAlignment="Left"
                        Visibility="{Binding HasExpirationDate, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Category" Style="{StaticResource DialogFieldLabel}"/>
                <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" SelectedValue="{Binding CategoryId, TargetNullValue=0}"/>
                <TextBlock Text="Supplier" Style="{StaticResource DialogFieldLabel}"/>
                <ComboBox ItemsSource="{Binding SupplierOptions}" DisplayMemberPath="CompanyName" SelectedValuePath="SupplierId" SelectedValue="{Binding SupplierId, TargetNullValue=0}"/>
            </StackPanel>
        </views:FormOverlay>
    </Grid>
</UserControl>
