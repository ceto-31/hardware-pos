<UserControl x:Class="HardwarePOS.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HardwarePOS.Helpers">
    <TabControl Style="{StaticResource ModernTabControl}"
                ItemContainerStyle="{StaticResource ModernTabItem}"
                UseLayoutRounding="True" SnapsToDevicePixels="True"
                SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="New Sale">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Product picker -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Search Products" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="Click a product row to add it to the cart."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:TextBoxHelper.Placeholder="Search by name or code…"/>
                        </StackPanel>

                        <DataGrid x:Name="ProductGrid"
                                  Style="{StaticResource ModernDataGrid}"
                                  ItemsSource="{Binding ProductList}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  RowHeight="48"
                                  PreviewMouseLeftButtonUp="ProductGrid_OnPreviewMouseLeftButtonUp">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="48" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="40" Height="40" Background="#F1F5F9" CornerRadius="4"
                                                    ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid>
                                                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                                                        <Path Data="{StaticResource IconCamera}" Fill="#94A3B8"/>
                                                    </Viewbox>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                                                           Stretch="Uniform" Width="40" Height="40"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="80"/>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTemplateColumn Header="Price" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EffectivePrice, StringFormat=N2}"/>
                                                <TextBlock Text="SALE" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           Visibility="{Binding IsOnSale, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockQty, StringFormat=N0}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Cart + checkout -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Shopping Cart"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <StackPanel DockPanel.Dock="Bottom">
                            <!-- Totals -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="108"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Subtotal" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Subtotal, StringFormat=₱{0:N2}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="{Binding TaxRate, StringFormat=VAT ({0:P0})}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding TaxAmount, StringFormat=₱{0:N2}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="Total Due" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding TotalDue, StringFormat=₱{0:N2}}"
                                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Payment -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="108"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Amount Tendered" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource NumericInput}"
                                             Text="{Binding CashTendered, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="1" Text="Change" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding ChangeAmount, StringFormat=₱{0:N2}}"
                                               FontWeight="SemiBold" Foreground="#16A34A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Actions -->
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="−" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DecreaseQtyCommand}" Width="32" MinWidth="32" Padding="0"/>
                                <Button Content="+" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding IncreaseQtyCommand}" Width="32" MinWidth="32" Padding="0"/>
                                <Button Content="Remove" Style="{StaticResource DangerButton}" Command="{Binding RemoveCartItemCommand}"/>
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelTransactionCommand}"/>
                                <Button Content="Checkout" Style="{StaticResource PrimaryButton}" Command="{Binding CheckoutCommand}"/>
                            </WrapPanel>
                        </StackPanel>

                        <DataGrid Style="{StaticResource ModernDataGrid}"
                                  ItemsSource="{Binding Cart}"
                                  SelectedItem="{Binding SelectedCartItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N0}" Width="52">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridNumericHeader}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="68">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridNumericHeader}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="72">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridNumericHeader}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Transaction History">
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,6,0"
                                 Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:TextBoxHelper.Placeholder="Search by invoice, cashier, or date…"/>
                        <Button Grid.Column="1" Content="Preview Receipt" MinWidth="110"
                                Style="{StaticResource SecondaryButton}" Command="{Binding PreviewSelectedReceiptCommand}"/>
                    </Grid>
                    <DataGrid Style="{StaticResource ModernDataGrid}"
                              ItemsSource="{Binding SaleHistory}"
                              SelectedItem="{Binding SelectedSale}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="*"/>
                            <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="120"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalDue, StringFormat=N2}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
