<UserControl x:Class="HardwarePOS.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HardwarePOS.Helpers"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:views="clr-namespace:HardwarePOS.Views">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource ManagementCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox MinHeight="40" VerticalAlignment="Center" Margin="0,0,12,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:TextBoxHelper.Placeholder="Search suppliers by name or contact…"/>
                        <Button Grid.Column="1" Content="+ Add Supplier" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Command="{Binding NewCommand}"/>
                    </Grid>
                    <DataGrid Style="{StaticResource ManagementDataGrid}"
                              RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="76"
                              ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Company" Width="2*" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CompanyName}"/>
                                            <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" ToolTip="{Binding Address}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="*" MinWidth="140"
                                                ElementStyle="{StaticResource ManagementGridText}"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="150" MinWidth="130"
                                                ElementStyle="{StaticResource ManagementGridText}"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*" MinWidth="190"
                                                ElementStyle="{StaticResource ManagementGridText}"/>
                            <DataGridTemplateColumn Header="Status" Width="148" MinWidth="136">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusBadgeTemplate}"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="168" MinWidth="156">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Style="{StaticResource ManagementActions}">
                                            <Button Style="{StaticResource ManagementActionButton}" ToolTip="Edit"
                                                    ContentTemplate="{StaticResource EditIconContent}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource ManagementActionButton}" ToolTip="Archive"
                                                    ContentTemplate="{StaticResource ArchiveIconContent}"
                                                    Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource ManagementActionButtonDanger}" ToolTip="Delete"
                                                    ContentTemplate="{StaticResource DeleteIconContent}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <views:FormOverlay Title="{Binding FormTitle}"
                           Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}"
                           CancelCommand="{Binding CloseFormCommand}"
                           SaveCommand="{Binding SaveCommand}">
            <StackPanel>
                <TextBlock Text="Company Name" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Contact Person" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Phone" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Email" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Address" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
                <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,8,0,0"/>
            </StackPanel>
        </views:FormOverlay>
    </Grid>
</UserControl>
