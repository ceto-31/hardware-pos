<UserControl x:Class="HardwarePOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <Style x:Key="DashboardEmptyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentDateTime}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WelcomeMessage}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding UserDisplay}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource DashboardKpiIcon}" Background="#DBEAFE" DockPanel.Dock="Left">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconCart}" Fill="{StaticResource PrimaryBrush}"/>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardKpiTitle}" Text="TODAY'S SALES"/>
                            <TextBlock Style="{StaticResource DashboardKpiValue}"
                                       Text="{Binding TodaySales, StringFormat=₱{0:N2}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource DashboardKpiIcon}" Background="#DCFCE7" DockPanel.Dock="Left">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconTrend}" Fill="{StaticResource SuccessBrush}"/>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardKpiTitle}" Text="TOTAL TRANSACTIONS"/>
                            <TextBlock Style="{StaticResource DashboardKpiValue}" Text="{Binding TodayTransactions}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource DashboardKpiIcon}" Background="#FFEDD5" DockPanel.Dock="Left">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconBox}" Fill="{StaticResource AccentBrush}"/>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardKpiTitle}" Text="TOTAL ITEMS SOLD"/>
                            <TextBlock Style="{StaticResource DashboardKpiValue}"
                                       Text="{Binding TodayItemsSold, StringFormat=N0}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource DashboardKpiIcon}" Background="#F3E8FF" DockPanel.Dock="Left">
                            <TextBlock Text="₱" FontSize="22" FontWeight="SemiBold" Foreground="#7C3AED"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardKpiTitle}" Text="GROSS PROFIT"/>
                            <TextBlock Style="{StaticResource DashboardKpiValue}"
                                       Text="{Binding TodayGrossProfit, StringFormat=₱{0:N2}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="3" Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}">
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource DashboardKpiIcon}" Background="#FEF3C7" DockPanel.Dock="Left">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconBox}" Fill="{StaticResource WarningBrush}"/>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardKpiTitle}" Text="LOW STOCK ITEMS"/>
                            <TextBlock Style="{StaticResource DashboardKpiValue}" Text="{Binding LowStockCount}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource DashboardKpiIcon}" Background="#FEE2E2" DockPanel.Dock="Left">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconBox}" Fill="{StaticResource DangerBrush}"/>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardKpiTitle}" Text="OUT OF STOCK"/>
                            <TextBlock Style="{StaticResource DashboardKpiValue}" Text="{Binding OutOfStockCount}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource DashboardKpiIcon}" Background="#FFEDD5" DockPanel.Dock="Left">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource IconBox}" Fill="{StaticResource AccentBrush}"/>
                            </Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DashboardKpiTitle}" Text="EXPIRING SOON"/>
                            <TextBlock Style="{StaticResource DashboardKpiValue}" Text="{Binding ExpiringSoonCount}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}" MinHeight="300">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource DashboardSectionTitle}" Text="Sales Overview"/>
                            <ComboBox Width="130" HorizontalAlignment="Right"
                                      ItemsSource="{Binding ChartRangeOptions}"
                                      SelectedItem="{Binding SelectedChartRange}"/>
                        </Grid>
                        <lvc:CartesianChart Series="{Binding OverviewSeries}"
                                            XAxes="{Binding OverviewXAxes}"
                                            YAxes="{Binding YAxes}"
                                            LegendPosition="Hidden"
                                            TooltipPosition="Top"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" MinHeight="300">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource DashboardSectionTitle}" Text="Top Selling Items"/>
                            <Button Content="View All" Style="{StaticResource DashboardViewAll}" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.NavigateProductsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="No products sold yet" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardEmptyText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopProducts.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding TopProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" Background="#EFF6FF"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Rank}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" Width="36" Height="36" Background="#F1F5F9" CornerRadius="6"
                                                    ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Grid>
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="{StaticResource IconCamera}" Fill="#94A3B8"/>
                                                    </Viewbox>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                                                           Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding ProductName}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding QtyLabel}" Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" FontSize="13"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <UniformGrid Columns="{Binding BottomPanelColumns}">
                <Border Style="{StaticResource CardBorder}" MinHeight="260">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource DashboardSectionTitle}" Text="Low Stock Alert"/>
                            <Button Content="View All" Style="{StaticResource DashboardViewAll}" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.NavigateInventoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="All stock levels look healthy" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardEmptyText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InventoryAlerts.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding InventoryAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#F1F5F9" CornerRadius="6"
                                                    ClipToBounds="True" VerticalAlignment="Center">
                                                <Grid>
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="{StaticResource IconCamera}" Fill="#94A3B8"/>
                                                    </Viewbox>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                                                           Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                                                    <Run Text="{Binding StockQty, Mode=OneWay, StringFormat=N0}"/>
                                                    <Run Text="{Binding UnitOfMeasure, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlertBadge}" Value="Critical">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding AlertBadge}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AlertBadge}" Value="Critical">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" MinHeight="260">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource DashboardSectionTitle}" Text="Expiring Soon"/>
                            <Button Content="View All" Style="{StaticResource DashboardViewAll}" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.NavigateInventoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="No products expiring soon" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardEmptyText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExpirationAlerts.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding ExpirationAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" Background="#F1F5F9" CornerRadius="6"
                                                    ClipToBounds="True" VerticalAlignment="Center">
                                                <Grid>
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="{StaticResource IconCamera}" Fill="#94A3B8"/>
                                                    </Viewbox>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                                                           Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ExpirationDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFEDD5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExpirationBadge}" Value="Expired">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ExpirationBadge}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExpirationBadge}" Value="Expired">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" MinHeight="260"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource DashboardSectionTitle}"
                                   Text="Recent Transactions" Margin="0,0,0,10"/>
                        <Grid>
                            <TextBlock Text="No transactions yet" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardEmptyText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentSales.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding RecentSales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Data="{StaticResource IconReceipt}" Fill="{StaticResource PrimaryBrush}"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InvoiceNo}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SaleDate, StringFormat=hh:mm tt}"
                                                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalDue, StringFormat=₱{0:N2}}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" MinHeight="260"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource DashboardSectionTitle}"
                                   Text="Sales by Payment Method" Margin="0,0,0,4"/>
                        <Grid>
                            <lvc:PieChart Series="{Binding PaymentSeries}"
                                          LegendPosition="Bottom"
                                          InitialRotation="-90"
                                          MinHeight="200"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,28"
                                        IsHitTestVisible="False">
                                <TextBlock Text="Cash" HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding TodaySales, StringFormat=₱{0:N2}}"
                                           FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
