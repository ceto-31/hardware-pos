<UserControl x:Class="HardwarePOS.Views.DiscountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HardwarePOS.Helpers"
             xmlns:views="clr-namespace:HardwarePOS.Views">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource ManagementCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox MinHeight="40" VerticalAlignment="Center" Margin="0,0,12,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:TextBoxHelper.Placeholder="Search discounts by name…"/>
                        <CheckBox Grid.Column="1" Content="Show archived" IsChecked="{Binding ShowArchived}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Column="2" Content="+ Add Discount" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Command="{Binding NewCommand}"/>
                    </Grid>
                    <TextBlock Text="No discounts found."
                               Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}"
                               Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" HorizontalAlignment="Center"/>
                    <DataGrid Style="{StaticResource ManagementDataGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DiscountName}" Width="*" MinWidth="160"
                                                ElementStyle="{StaticResource ManagementGridText}"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeDisplay}" Width="140" MinWidth="120"
                                                ElementStyle="{StaticResource ManagementGridText}"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueDisplay}" Width="120" MinWidth="100"
                                                ElementStyle="{StaticResource ManagementGridText}"/>
                            <DataGridTextColumn Header="Period" Binding="{Binding PeriodDisplay}" Width="220" MinWidth="190"
                                                ElementStyle="{StaticResource ManagementGridText}"/>
                            <DataGridTemplateColumn Header="Status" Width="156" MinWidth="144">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusBadgeTemplate}"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="160" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Style="{StaticResource ManagementActions}">
                                            <Button Style="{StaticResource ManagementActionButton}" ToolTip="Edit"
                                                    ContentTemplate="{StaticResource EditIconContent}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource ManagementActionButton}" ToolTip="Archive"
                                                    ContentTemplate="{StaticResource ArchiveIconContent}"
                                                    Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsArchived, Converter={StaticResource InverseBoolToVis}}"/>
                                            <Button Style="{StaticResource ManagementActionButton}" ToolTip="Restore"
                                                    ContentTemplate="{StaticResource RestoreIconContent}"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsArchived, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource ManagementActionButtonDanger}" ToolTip="Delete"
                                                    ContentTemplate="{StaticResource DeleteIconContent}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <views:FormOverlay Title="{Binding FormTitle}"
                           Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}"
                           CancelCommand="{Binding CloseFormCommand}"
                           SaveCommand="{Binding SaveCommand}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel>
                    <TextBlock Text="Discount Name" Style="{StaticResource DialogFieldLabel}"/>
                    <TextBox Text="{Binding DiscountName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Apply To" Style="{StaticResource DialogFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding ApplyScope}"/>

                    <StackPanel Visibility="{Binding IsCategoryScope, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Category" Style="{StaticResource DialogFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}"
                                  SelectedValuePath="CategoryId"
                                  SelectedValue="{Binding CategoryId}"
                                  DisplayMemberPath="CategoryName"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsProductScope, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Products" Style="{StaticResource DialogFieldLabel}"/>
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" MaxHeight="160">
                            <ListBox ItemsSource="{Binding ProductOptions}" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Discount Type" Style="{StaticResource DialogFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DiscountTypeOptions}" SelectedItem="{Binding DiscountType}"/>

                    <TextBlock Text="{Binding ValueLabel}" Style="{StaticResource DialogFieldLabel}"/>
                    <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Start Date" Style="{StaticResource DialogFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding StartDate}"/>

                    <TextBlock Text="End Date" Style="{StaticResource DialogFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding EndDate}"/>
                </StackPanel>
            </ScrollViewer>
        </views:FormOverlay>
    </Grid>
</UserControl>
