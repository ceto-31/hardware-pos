<Window x:Class="HardwarePOS.Views.TransactionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="520" Height="560"
        FontFamily="Segoe UI">
    <Grid>
        <Border Background="#990F172A"/>
        <Border Width="460" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#0F172A"/>
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="6" Background="#2563EB" CornerRadius="8,8,0,0"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click" MinWidth="96" IsCancel="True"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,8">
                    <StackPanel>
                        <TextBlock Text="Transaction" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="InvoiceText" Margin="0,10,0,0" FontFamily="Consolas" FontWeight="SemiBold" FontSize="15" Foreground="#0F172A" TextWrapping="Wrap"/>
                        <TextBlock x:Name="WhenText" Margin="0,4,0,0" FontSize="13" Foreground="#64748B"/>
                        <TextBlock x:Name="CashierText" Margin="0,2,0,0" FontSize="14" Foreground="#334155" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OrderTypeText" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock x:Name="DeliveryText" Margin="0,4,0,0" FontSize="13" Foreground="#475569" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Border x:Name="StatusBadge" Margin="0,10,0,0" HorizontalAlignment="Left" CornerRadius="4" Padding="8,3"/>
                        <TextBlock x:Name="ReasonText" Margin="0,8,0,0" FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Border Height="1" Background="#E2E8F0" Margin="0,14,0,10"/>
                        <StackPanel x:Name="ItemsPanel"/>
                        <Border Height="1" Background="#E2E8F0" Margin="0,10,0,10"/>
                        <TextBlock x:Name="SubtotalText" FontSize="13" Foreground="#475569"/>
                        <TextBlock x:Name="TaxText" FontSize="13" Foreground="#475569"/>
                        <TextBlock x:Name="DiscountText" FontSize="13" Foreground="#475569"/>
                        <TextBlock x:Name="TotalText" Margin="0,6,0,0" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
